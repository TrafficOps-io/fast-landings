APP_NAME="Fast Landings"
APP_ENV=production
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=false
APP_URL=https://panel.example.com
LOG_CHANNEL=stderr
LOG_LEVEL=warning
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=fast_landings
DB_USERNAME=fast_landings
DB_PASSWORD=development-placeholder
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_COOKIE=__Host-fast_landings_session
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
# Any Laravel filesystem disk; use s3 with the AWS_* settings for editor images.
FAST_LANDINGS_MEDIA_DISK=local
LANDINGS_PATH=/var/lib/fast-landings/landings
FAST_LANDINGS_PANEL_DOMAIN=panel.example.com
FAST_LANDINGS_SYSTEM_DOMAIN=go.example.com
# Replace with the server public IPv4 (A), IPv6 (AAAA), or hostname (CNAME).
FAST_LANDINGS_ORIGIN_TARGET=203.0.113.10
FAST_LANDINGS_MAX_UPLOAD_MB=100
FAST_LANDINGS_MAX_EXTRACTED_MB=300
FAST_LANDINGS_MAX_FILES=5000
FAST_LANDINGS_MAX_EXPANSION_RATIO=200
FAST_LANDINGS_MAX_PATH_BYTES=1024
FAST_LANDINGS_MAX_PATH_DEPTH=32
FAST_LANDINGS_SPA_FALLBACK=true
FAST_LANDINGS_CADDY_ASK_TOKEN=development-placeholder
TRUSTED_PROXIES=REMOTE_ADDR
