APP_NAME="Fast Landings"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://landings.localhost:8090
SERVER_HOST=127.0.0.1
SERVER_PORT=8090
TRUSTED_PROXIES=

FAST_LANDINGS_PANEL_DOMAIN=landings.localhost
FAST_LANDINGS_SYSTEM_DOMAIN=landings.localhost
FAST_LANDINGS_ORIGIN_TARGET=origin.localhost
FAST_LANDINGS_CADDY_ASK_TOKEN=
FAST_LANDINGS_MAX_UPLOAD_MB=100
FAST_LANDINGS_MAX_EXTRACTED_MB=300
FAST_LANDINGS_MAX_FILES=5000
FAST_LANDINGS_MAX_EXPANSION_RATIO=200
FAST_LANDINGS_MAX_PATH_BYTES=1024
FAST_LANDINGS_MAX_PATH_DEPTH=32
FAST_LANDINGS_SPA_FALLBACK=true
FAST_LANDINGS_MEDIA_DISK=local
FAST_LANDINGS_EDITOR_AI=true
FAST_LANDINGS_PREVIEWS_ENABLED=true
FAST_LANDINGS_NODE_BINARY=node
FAST_LANDINGS_CHROMIUM_PATH=
FAST_LANDINGS_PHP_ADDRESS=tcp://127.0.0.1:9070
FAST_LANDINGS_PHP_STORAGE_ROOT=/srv/landings
FAST_LANDINGS_PHP_TIMEOUT=35
FAST_LANDINGS_PHP_MAX_RESPONSE_MB=32
FAST_LANDINGS_PHP_UID=1000
FAST_LANDINGS_PHP_GID=1000
LANDINGS_PATH=./storage/app/landings

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54331
DB_DATABASE=fast_landings
DB_USERNAME=fast_landings
DB_PASSWORD=local-development-only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
VITE_PORT=5175
