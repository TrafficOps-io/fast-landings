{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "trafficops/fast-landings-ui",
    "description": "Vendored design system for the Fast Landings application.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^12.0",
        "illuminate/view": "^12.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "TrafficOps\\FastLandings\\Ui\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TrafficOps\\FastLandings\\Ui\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TrafficOps\\FastLandings\\Ui\\UiServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
